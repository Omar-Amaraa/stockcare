# ---- Database ----
POSTGRES_DB=stockcare
POSTGRES_USER=stockcare
POSTGRES_PASSWORD=stockcare
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Must be at least 32 characters for HS256 signing
STOCKCARE_JWT_SECRET=change-me-in-production-please-use-a-long-random-secret-key-32b+
STOCKCARE_JWT_EXPIRATION_MINUTES=120
# Seed the development database with demo accounts and sample data
STOCKCARE_SEED_ENABLED=true
STOCKCARE_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Frontend ----
FRONTEND_PORT=4200

# ---- Prediction service (Python / LightGBM) ----
PREDICTION_PORT=8000
# 'external' uses the real model service; 'mock' uses the built-in rule-based predictor.
STOCKCARE_MODEL_PREDICTION_MODE=external
STOCKCARE_PREDICTION_URL=http://prediction-service:8000
STOCKCARE_PREDICTION_TIMEOUT_MS=8000

# ---- Routing service (Python / VRP-MILP, CBC solver) ----
ROUTING_PORT=8002
# 'external' uses the real MILP optimizer; 'mock' uses the built-in greedy router.
STOCKCARE_MODEL_ROUTE_MODE=external
STOCKCARE_ROUTING_URL=http://routing-service:8000
# A fleet-wide solve can run for the solver's full time limit; keep this above it.
STOCKCARE_ROUTING_TIMEOUT_MS=90000
STOCKCARE_MODEL_ROUTE_VERSION=milp-care-v1

# ---- Automated workflows ----
# On predicted shortage: draft (auto-create draft request) | alert (notify only) | off
STOCKCARE_WORKFLOW_SHORTAGE_ACTION=draft
STOCKCARE_WORKFLOW_AUTO_SUBMIT=false
STOCKCARE_WORKFLOW_AUTO_PRIORITY=true
# When true, approving requests for planning triggers a fleet-wide MILP solve automatically.
STOCKCARE_WORKFLOW_AUTO_ROUTE=true
# Wait for at least this many approved, unplanned requests before solving.
STOCKCARE_WORKFLOW_AUTO_ROUTE_MIN_REQUESTS=1

# ---- Optional tools ----
ADMINER_PORT=8081
